# Kostenlos: TRANSCRIBER=whisperx (lokal). Alternative (kostenpflichtig): assemblyai
TRANSCRIBER=whisperx
WHISPERX_URL=http://127.0.0.1:8000
ASSEMBLYAI_API_KEY=
# Empfohlen: Passwortschutz der App (Benutzername egal)
APP_PASSWORD=
MAX_MB=500
PORT=3000
# Zusammenfassung (kostenlos, lokal via Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
# Aufbewahrungsdauer der Audiodateien in Tagen
RETENTION_DAYS=30
