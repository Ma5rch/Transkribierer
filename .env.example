# Standard: Transkription über AssemblyAI
# Persönlichen API-Key nur in .env eintragen, niemals hier oder in GitHub!
TRANSCRIBER=assemblyai
ASSEMBLYAI_API_KEY=
# Optionaler Passwortschutz der App (empfohlen bei Veröffentlichung)
APP_PASSWORD=
MAX_MB=500
PORT=3000

# Alternative: WhisperX selbst betreiben
# TRANSCRIBER=whisperx
WHISPERX_URL=http://127.0.0.1:8000

# Optionale Zusammenfassung über Ollama (lokal)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Aufbewahrungsdauer hochgeladener Audiodateien in Tagen
RETENTION_DAYS=30
